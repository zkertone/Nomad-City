{
  "name": "nomad-city-online",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/game-core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p packages/web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsc -p packages/server/tsconfig.build.json && npm run build --workspace @nomad-city-online/web",
    "dev": "npm run build && node scripts/dev-local.mjs",
    "dev:local": "npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:maps": "npm run build && node scripts/check-maps.mjs",
    "check:events": "npm run build && node scripts/check-events.mjs",
    "check:game": "npm run build && node scripts/check-game.mjs",
    "check:entry": "npm run build && node scripts/check-entry.mjs",
    "check:settlement": "npm run build && node scripts/check-settlement.mjs",
    "check:exploration": "npm run build && node scripts/check-exploration.mjs",
    "check:city-move": "npm run build && node scripts/check-city-move.mjs",
    "check:influence": "npm run build && node scripts/check-influence.mjs",
    "check:harvest": "npm run build && node scripts/check-harvest.mjs",
    "check:final-scoring": "npm run build && node scripts/check-final-scoring.mjs",
    "check:player-api": "npm run build && node scripts/check-final-scoring.mjs --player-api",
    "check:scoring": "npm run build && node scripts/check-scoring.mjs",
    "check:schemes": "npm run build && node scripts/check-role-schemes.mjs",
    "check:liskarm": "npm run build && node scripts/check-liskarm.mjs",
    "check:roles": "npm run build && node scripts/check-role-effects.mjs",
    "check:rounds": "npm run build && node scripts/check-rounds.mjs",
    "check:construction": "npm run build && node scripts/check-construction.mjs",
    "check:warehouse": "npm run build && node scripts/check-warehouse.mjs",
    "check:remaining-facilities": "npm run build && node scripts/check-remaining-facilities.mjs",
    "check:facility-entries": "npm run build && node scripts/check-facility-entries.mjs",
    "check:temporary-settlements": "npm run build && node scripts/check-temporary-settlements.mjs",
    "check:pattern-major-actions": "npm run build && node scripts/check-pattern-major-actions.mjs",
    "check:pattern-continuations": "npm run build && node scripts/check-pattern-continuations.mjs",
    "check:pattern-actions": "npm run build && node scripts/check-pattern-actions.mjs",
    "check:patterns": "npm run build && node scripts/check-patterns.mjs",
    "check:facilities": "npm run build && node scripts/check-facilities.mjs",
    "archive": "python3 scripts/archive.py",
    "check:rooms": "npm run build && node scripts/check-room-service.mjs",
    "check:rooms:postgres": "npm run build && node scripts/check-room-service.mjs --postgres",
    "check:sockets": "npm run build && node scripts/check-room-service.mjs --sockets",
    "check:sockets:postgres": "npm run build && node scripts/check-room-service.mjs --sockets --postgres",
    "check:automatic-rooms": "npm run build && node scripts/check-automatic-rooms.mjs",
    "check:automatic-rooms:postgres": "npm run build && node scripts/check-automatic-rooms.mjs --postgres",
    "check:lobbies": "npm run build && node scripts/check-automatic-rooms.mjs --lobbies",
    "check:lobbies:postgres": "npm run build && node scripts/check-automatic-rooms.mjs --lobbies --postgres",
    "check:local-web": "npm run build && node scripts/check-local-web.mjs",
    "check:travel-web": "npm run build && node scripts/check-travel-web.mjs",
    "check:construction-web": "npm run build && node scripts/check-construction-web.mjs",
    "check:quick-web": "npm run build && node scripts/check-quick-web.mjs",
    "check:harvest-web": "npm run build && node scripts/check-harvest-web.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "socket.io-client": "4.8.4"
  }
}
