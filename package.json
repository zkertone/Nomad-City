{
  "name": "nomad-city-online",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0", "npm": ">=10" },
  "workspaces": ["packages/game-core"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:maps": "npm run build && node scripts/check-maps.mjs",
    "check:events": "npm run build && node scripts/check-events.mjs",
    "check:game": "npm run build && node scripts/check-game.mjs",
    "archive": "python3 scripts/archive.py"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
