  "cards": [
    {
      "id": "G01",
      "title": "废弃矿坑",
      "color": "green",
      "hasFourPlayerMark": true,
      "resourceMarker": {
        "resource": "originium",
        "harvestAmount": 1
      },
      "description": "你派去的札拉克探子派上了大用处！他们装神弄鬼吓跑了这座矿井的工人。这让你不费吹灰之力就获得了一处源石矿场。但或许是有些做过头了，矿工们在逃离这里时竟把入口都给炸了。现在想让矿井重新运转起来成了一道难题。",
      "choices": [
        {
          "id": "G01:1",
          "narration": "先把矿井外留下的资源设备收走。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "iron",
              "amount": 2
            },
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "columbia-voucher",
              "amount": 2
            }
          ]
        },
        {
          "id": "G01:2",
          "narration": "“看看你们干的好事！天黑前要是不把这挖通就把你们活埋在源岩里！”",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "orirock",
              "amount": 4
            }
          ]
        }
      ],
      "sourceRef": "S1"
    },
    {
      "id": "G02",
      "title": "清理虫巢",
      "color": "green",
      "hasFourPlayerMark": false,
      "resourceMarker": {
        "resource": "iron",
        "harvestAmount": 1
      },
      "description": "多方势力垂涎这座外露的异铁矿床已久，但却从未有人下手——因为这里盘踞的源石虫多到足以淹没整座聚落。好在，你的手下正好有这么几个落魄术士，擅长驱赶此类害虫，不久源石虫就被“永久挪了窝”。",
      "choices": [
        {
          "id": "G02:1",
          "narration": "向当地治安官邀功。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "columbia-voucher",
              "amount": 7
            }
          ]
        },
        {
          "id": "G02:2",
          "narration": "附近聚落居民向你表达感谢。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "originium",
              "amount": 3
            }
          ]
        }
      ],
      "sourceRef": "S1"
    },
    {
      "id": "G03",
      "title": "矿业聚落",
      "color": "green",
      "hasFourPlayerMark": false,
      "resourceMarker": {
        "resource": "originium",
        "harvestAmount": 1
      },
      "description": "这里曾是这片开拓区一处相对繁荣的源石矿区，但简陋的装备和未清理的源石尘让大部分矿工深陷于矿石病的危害之中，现在这里已经濒临衰败。",
      "choices": [
        {
          "id": "G03:1",
          "narration": "用约翰老妈提供的抑制剂换取开采合同。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "originium",
              "amount": 3
            }
          ]
        },
        {
          "id": "G03:2",
          "narration": "收取费用，并为他们提供一片相对安全的聚居区。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "columbia-voucher",
              "amount": 7
            }
          ]
        }
      ],
      "sourceRef": "S1"
    },
    {
      "id": "G04",
      "title": "中立采石场",
      "color": "green",
      "hasFourPlayerMark": false,
      "resourceMarker": {
        "resource": "orirock",
        "harvestAmount": 1
      },
      "description": "带着补给的武装车队旁若无人地驶入了这座早期勘探队伍建立的采石场。“我们只效劳于金券，不会效忠于任何当地竞争者！”这座采石场的领导者向你的人马喊道。",
      "choices": [
        {
          "id": "G04:1",
          "narration": "“我们只是过来兑换一些燃料，并谈谈生意”。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "originium",
              "amount": 3
            }
          ]
        },
        {
          "id": "G04:2",
          "narration": "“今天起这里不再由你说了算了”。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "iron",
              "amount": 2
            },
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "columbia-voucher",
              "amount": 2
            }
          ]
        }
      ],
      "sourceRef": "S1"
    },
    {
      "id": "G05",
      "title": "外露矿床",
      "color": "green",
      "hasFourPlayerMark": false,
      "resourceMarker": {
        "resource": "originium",
        "harvestAmount": 1
      },
      "description": "在不久前，一场小规模的天灾洗刷了这片拓荒区的边界，就连安全区也受到了部分波及。但也并非全是坏事，这里新产生的源石晶簇群便是最好的证明。",
      "choices": [
        {
          "id": "G05:1",
          "narration": "清理出一片场地来建设矿区。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "orirock",
              "amount": 4
            }
          ]
        },
        {
          "id": "G05:2",
          "narration": "把成堆的粗劣源石带回城。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "originium",
              "amount": 3
            }
          ]
        }
      ],
      "sourceRef": "S1"
    },
    {
      "id": "G06",
      "title": "富饶岩层",
      "color": "green",
      "hasFourPlayerMark": false,
      "resourceMarker": {
        "resource": "orirock",
        "harvestAmount": 1
      },
      "description": "你手拿着荒地人向导倒卖的旧地图，到达了标记有源石矿藏的位置，但那儿的源石早已不知去向。在注意到了地图下角的绘制日期后，你不禁顿足准备破口大骂。但鞋底踩上的那些带有小孔的松软土壤，倒也不算是空手而归。",
      "choices": [
        {
          "id": "G06:1",
          "narration": "现在就装一车源岩回城。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "orirock",
              "amount": 4
            }
          ]
        },
        {
          "id": "G06:2",
          "narration": "迫使卖给你“过期地图”的家伙弥补损失。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "originium",
              "amount": 3
            }
          ]
        }
      ],
      "sourceRef": "S1"
    },
    {
      "id": "Y01",
      "title": "遭弃矿场",
      "color": "yellow",
      "hasFourPlayerMark": false,
      "resourceMarker": {
        "resource": "originium",
        "harvestAmount": 1
      },
      "description": "“这里附近曾发生过一场天灾，天灾信使在通报的途中不幸遇难，但所幸空中异常的天灾云足够明显，让矿工迅速反应过来并撤离了这里。但可笑的是，天灾最终并未直接打击这座矿场，哈哈。”",
      "choices": [
        {
          "id": "Y01:1",
          "narration": "拆除这里的设施，带走有用的材料。",
          "cost": null,
          "effects": [
            {
              "kind": "gain",
              "recipient": "actor",
              "asset": "iron",
              "amount": 3
            }
          ]
        },
        {
          "id": "Y01:2",
